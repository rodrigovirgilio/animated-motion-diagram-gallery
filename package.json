{
  "name": "animated-motion-diagram-gallery",
  "version": "1.0.0",
  "private": true,
  "description": "Community templates and themes for Animated Motion Diagram. Merge to main publishes to the app gallery.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "manifest": "node scripts/manifest.mjs",
    "manifest:check": "node scripts/manifest.mjs --check",
    "sync": "node scripts/sync-supabase.mjs",
    "mock": "node scripts/mock-supabase.mjs",
    "test": "node --test scripts/lib.test.mjs scripts/triage.test.mjs",
    "check": "npm run validate && npm run manifest:check && npm test"
  },
  "keywords": [
    "animated-motion-diagram",
    "technical-diagrams",
    "templates",
    "themes"
  ],
  "license": "MIT"
}
